                        <td><button class="action-btn" onclick="alert('Loading details...')">View</button></td>
                    </tr>
                    <tr>
                        <td>1RV21IS065</td>
                        <td>Karthik Rao</td>
                        <td>Information Science</td>
                        <td>Attendance Query</td>
                        <td>09:42 AM</td>
                        <td><span class="badge">Completed</span></td>
                        <td><button class="action-btn" onclick="alert('Loading details...')">View</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
