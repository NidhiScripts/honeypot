                        <td>Fee Payment</td>
                        <td>10:45 AM</td>
                        <td><span class="badge">Completed</span></td>
                        <td><button class="action-btn" onclick="alert('Loading details...')">View</button></td>
                    </tr>
                    <tr>
                        <td>1RV21EC042</td>
                        <td>Priya Sharma</td>
                        <td>Electronics</td>
                        <td>Grade Update</td>
                        <td>10:32 AM</td>
                        <td><span class="badge">Completed</span></td>
                        <td><button class="action-btn" onclick="alert('Loading details...')">View</button></td>
                    </tr>
                    <tr>
                        <td>1RV21ME078</td>
                        <td>Amit Verma</td>
                        <td>Mechanical</td>
                        <td>Course Registration</td>
                        <td>10:15 AM</td>
                        <td><span class="badge">Completed</span></td>
                        <td><button class="action-btn" onclick="alert('Loading details...')">View</button></td>
                    </tr>
                    <tr>
                        <td>1RV21CV023</td>
                        <td>Sneha Reddy</td>
                        <td>Civil</td>
